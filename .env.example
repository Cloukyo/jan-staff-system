# Safe local default. Commercial deployments must set APP_ENV and APP_MODE explicitly.
APP_ENV=local
APP_MODE=demo
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional presentation configuration. Nursery is the compatibility profile.
NEXT_PUBLIC_PRODUCT_NAME=Workforce Operations Platform
NEXT_PUBLIC_PRODUCT_SHORT_NAME=Workforce Platform
NEXT_PUBLIC_PRODUCT_LOGO_PATH=
NEXT_PUBLIC_ORGANISATION_DISPLAY_NAME=Organisation
NEXT_PUBLIC_SITE_DISPLAY_NAME=Site
NEXT_PUBLIC_INDUSTRY_PROFILE=nursery
PLATFORM_SERVICE_IDENTIFIER=workforce-platform

# Required only for local production-mode testing.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_SERVICE_ROLE_KEY=

# Required for preview, staging and production separation checks.
PRODUCTION_SUPABASE_PROJECT_REF=
PRODUCTION_SITE_HOST=

# Vercel supplies VERCEL_GIT_COMMIT_SHA. Other runtimes can set DEPLOYMENT_SHA.
DEPLOYMENT_SHA=development
