# Safe local default. Commercial deployments must set APP_ENV and APP_MODE explicitly.
APP_ENV=local
APP_MODE=demo
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional presentation configuration. Nursery is the compatibility profile.
NEXT_PUBLIC_PRODUCT_NAME=Jan Staff
NEXT_PUBLIC_PRODUCT_SHORT_NAME=Jan Staff
NEXT_PUBLIC_PRODUCT_LOGO_PATH=
NEXT_PUBLIC_ORGANISATION_DISPLAY_NAME=Organisation
NEXT_PUBLIC_SITE_DISPLAY_NAME=Site
NEXT_PUBLIC_INDUSTRY_PROFILE=nursery
PLATFORM_SERVICE_IDENTIFIER=workforce-platform

# Required only for local production-mode testing.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_SERVICE_ROLE_KEY=
# Required only when the commercial organisation-selection routes are used.
COMMERCIAL_SESSION_SECRET=

# Commercial billing. Preview/staging accept Stripe test-mode values only.
# Keep all billing values server-only. Price maps are versioned by environment and internal plan.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MAP_JSON={"preview":{"preview_standard":{"1":"price_test_replace_me"}}}

# Commercial transactional delivery. Keep disabled outside isolated staging until configured.
NOTIFICATION_DELIVERY_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_ADDRESS=
RESEND_REPLY_TO_ADDRESS=
RESEND_STAGING_RECIPIENT=
RESEND_WEBHOOK_SECRET=
CRON_SECRET=

# Optional Cloudflare Turnstile site key. The private secret is configured only in Supabase Auth.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Controlled production pilot signup. The HMAC secret is server-only and at least 32 bytes.
COMMERCIAL_PILOT_SIGNUP_GATE=false
COMMERCIAL_PILOT_ACCESS_HMAC_SECRET=

# Required for preview, staging and production separation checks.
PRODUCTION_SUPABASE_PROJECT_REF=
PRODUCTION_SITE_HOST=

# Vercel supplies VERCEL_GIT_COMMIT_SHA. Other runtimes can set DEPLOYMENT_SHA.
DEPLOYMENT_SHA=development
